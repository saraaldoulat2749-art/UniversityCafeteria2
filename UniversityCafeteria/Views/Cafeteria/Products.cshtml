*@
@{
string[] Products = {"Water","Orange Juice","Coffee","Sandwich","Chocolate"};
}
<link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />

@foreach (var product in Products)
{
    <li>@product</li>
}

@if (Products.Length > 0)
{
    <p>We have @Products.Length products available.</p>
}
else
{
    <p>No products available.</p>
}

@if (Products.Length >= 3)
{
    <p>We have enough Products.</p>
}
else
{
    <p>We need more Products.</p>
}
@section Scripts {
    <script > alert('Welcome to the Products Page!'); </script>}