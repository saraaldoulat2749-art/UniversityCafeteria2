*@
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
@{
    string[] products = (string[])ViewData["Products"];
}
<div class="container mt-5">

    <h2>@ViewData["Page Title: "]</h2>

    <div class="card mb-3">
        <div class="card-body">
            <h5>Manager Name</h5>
            <p>@ViewData["ManagerName: "]</p>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>Number of Products</h5>
            <p>@ViewData["Number of Products: "]</p>
        </div>
    </div>

    @foreach (string product in products)
    {
        <div class="card mb-2">
            <div class="card-body">
                <h5>@product</h5>
            </div>
        </div>
    }

</div>