    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.PageTitle = "Our Suppliers";
}
<div class="container mt-5">

    <h2 class="mb-4">@ViewBag.PageTitle</h2>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Number of Suppliers</h5>
            <p>@ViewBag.NumberOfSuppliers</p>
        </div>
    </div>

    <h4 class="mb-3">Suppliers List</h4>

    <div class="row g-3">

        @foreach (string supplier in ViewBag.Suppliers)
        {
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5>@supplier</h5>
                    </div>
                </div>
            </div>
        }

    </div>

</div>
