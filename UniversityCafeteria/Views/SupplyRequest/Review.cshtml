@using UniversityCafeteria.Models

<h2>Review Request</h2>

<pre>@ViewBag.Products</pre>


<p>Subtotal: @ViewBag.Subtotal JD</p>

<p>Preparation Fee: @ViewBag.Fee JD</p>

<p>Discount: @ViewBag.Discount JD</p>

<h3>Final Total: @ViewBag.Total JD</h3>
<form method="post"
      action="@Url.Action("ConfirmRequest", "SupplyRequest")">

    <button type="submit" class="btn btn-success">
        Confirm Request
    </button>
</form>