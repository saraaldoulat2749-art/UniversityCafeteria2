
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - University Cafeteria</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>

<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand"
               href="@Url.Action("Index", "Cafeteria")">
                University Cafeteria
            </a>

            <div class="navbar-nav">

                <a class="nav-link"
                   href="@Url.Action("Index", "Cafeteria")">
                    Home
                </a>

                <a class="nav-link"
                   href="@Url.Action("Products", "Cafeteria")">
                    Products
                </a>

                <a class="nav-link"
                   href="@Url.Action("Suppliers", "Cafeteria")">
                    Suppliers
                </a>

                <a class="nav-link"
                   href="@Url.Action("Index", "SupplyRequest")">
                    Create Supply Request
                </a>

                <a class="nav-link"
                   href="@Url.Action("Review", "SupplyRequest")">
                    Review Draft
                </a>

                <a class="nav-link"
                   href="@Url.Action("MyRequests", "SupplyRequest")">
                    My Requests
                </a>

                <a class="nav-link"
                   href="@Url.Action("About", "SupplyRequest")">
                    About
                </a>

            </div>
        </div>
    </nav>

    <main class="container mt-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white text-center p-3 mt-5">
        <p class="mb-0">
            &copy; 2026 University Cafeteria.
            All Rights Reserved.
        </p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
